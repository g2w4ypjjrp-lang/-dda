# Üretim ortam değişkenleri (docker-compose.prod.yml). Bu dosyanın kopyası (.env.prod) git'e girmez;
# değerler gizli bilgi deposundan yazılır. Boş bırakılan zorunlu değerle uygulama açılmaz.

MI_ENVIRONMENT=production

# --- Dağıtım (M-G3 onayı) ---
MI_DOMAIN=
MI_ACME_EMAIL=
MI_VERSION=latest

# --- Kökenler (HTTPS zorunlu) ---
MI_PUBLIC_WEB_URL=https://ALAN_ADI
MI_PUBLIC_API_URL=https://ALAN_ADI
MI_WEB_ORIGINS=["https://ALAN_ADI"]
MI_ADMIN_ORIGINS=["https://ALAN_ADI"]
MI_SESSION_COOKIE_SECURE=true

# --- Yönetilen veritabanı ve Redis (TLS) ---
# Sağlayıcının CA sertifikası deploy/secrets/pg-ca.pem dosyasına konur (salt okunur bağlanır).
MI_DATABASE_URL=postgresql://KULLANICI:PAROLA@SUNUCU:5432/mi?sslmode=verify-full&sslrootcert=/etc/mi/pg-ca.pem
MI_REDIS_URL=rediss://:PAROLA@SUNUCU:6380/0

# --- Gizli anahtarlar (32 bayt, base64) ---
# python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MI_SECRET_KEK=
MI_LICENSE_PEPPER=
# Prometheus /metrics jetonu (deploy/prometheus/mi_metrics_token ile aynı)
MI_METRICS_TOKEN=

# --- Yedekleme ---
MI_BACKUP_KEEP=14

# --- Futbol verisi (M-G1 onayı): none | api_football | football_data ---
MI_FOOTBALL_PROVIDER=none
MI_FOOTBALL_API_KEY=

# --- Ödeme (M-G5 onayı olmadan canlı ödeme açılmaz) ---
MI_PAYMENT_PROVIDER=none
MI_PAYMENTS_TEST_MODE=true
MI_PAYMENTS_LIVE_ALLOWED=false
MI_PAYTR_MERCHANT_ID=
MI_PAYTR_MERCHANT_KEY=
MI_PAYTR_MERCHANT_SALT=
MI_IYZICO_API_KEY=
MI_IYZICO_SECRET_KEY=

# --- ML zamanlaması (--profile ml) ---
MI_ML_SCHEDULE_ENABLED=false

MI_LOG_LEVEL=INFO
MI_LOG_JSON=true
