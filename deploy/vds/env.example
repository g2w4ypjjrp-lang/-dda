# futbol.canarslan.net.tr — VDS kurulum ayarları. futbol.sh "kur" ilk çalıştırmada bu dosyadan
# deploy/vds/.env üretir ve gizli değerleri kendisi oluşturur (dosya izni 600, git'e girmez).

FUTBOL_DOMAIN=futbol.canarslan.net.tr
# Uygulamanın sunucu içinde dinlediği port (yalnızca 127.0.0.1). Doluysa başka bir port seçin.
FUTBOL_PORT=3080
# Bu projeye özel Docker ağı (172.30.88.0/24). Sunucudaki başka bir ağla çakışırsa değiştirin.
FUTBOL_SUBNET_PREFIX=172.30.88

# --- Gizli değerler (futbol.sh kur otomatik üretir) ---
FUTBOL_DB_PASSWORD=
FUTBOL_REDIS_PASSWORD=
MI_SECRET_KEK=
MI_LICENSE_PEPPER=
MI_METRICS_TOKEN=

# --- Yedekleme ---
MI_BACKUP_KEEP=14

# --- Futbol verisi (M-G1 onayı): none | api_football | football_data ---
MI_FOOTBALL_PROVIDER=none
MI_FOOTBALL_API_KEY=

# --- Ödeme (M-G5 onayı olmadan satış kapalı) ---
MI_PAYMENT_PROVIDER=none
MI_PAYMENTS_TEST_MODE=true
MI_PAYMENTS_LIVE_ALLOWED=false

# --- ML zamanlaması (--profile ml; gerçek veri sonrası) ---
MI_ML_SCHEDULE_ENABLED=false

MI_LOG_LEVEL=INFO
MI_LOG_JSON=true
