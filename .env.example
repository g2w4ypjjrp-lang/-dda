# docker-compose.yml için yerel geliştirme değerleri. Gerçek değerleri .env dosyasına yazın
# (.env git'e eklenmez). Üretimde bu değerler gizli bilgi deposundan verilir.
MI_DB_PASSWORD=
# 32 bayt, base64:  python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
MI_SECRET_KEK=
# Futbol veri sağlayıcısı (M-G1): none | api_football | football_data
MI_FOOTBALL_PROVIDER=none
MI_FOOTBALL_API_KEY=
# Ödeme (Faz 6): none | simulator (yalnızca geliştirme/test) | paytr | iyzico.
# Canlı ödeme (MI_PAYMENTS_TEST_MODE=false) yalnızca MI_PAYMENTS_LIVE_ALLOWED=true ile (M-G5 onayı).
MI_PAYMENT_PROVIDER=none
MI_PAYMENTS_TEST_MODE=true
MI_PAYMENTS_LIVE_ALLOWED=false
MI_PAYTR_MERCHANT_ID=
MI_PAYTR_MERCHANT_KEY=
MI_PAYTR_MERCHANT_SALT=
MI_IYZICO_API_KEY=
MI_IYZICO_SECRET_KEY=
# Lisans anahtarı özetleri için pepper (en az 32 bayt, base64). Değiştirilirse eski anahtarlar geçersizleşir.
MI_LICENSE_PEPPER=
